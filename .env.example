# Sunalyze — configuración local
#
# Copia este archivo a `.env` y ya puedes arrancar. Los valores de abajo
# funcionan tal cual: no hace falta editar nada ni instalar una base de datos.
#
#   macOS / Linux:  cp .env.example .env
#   Windows (cmd):  copy .env.example .env
#   PowerShell:     cp .env.example .env
#
# Más fácil todavía: `python scripts/setup.py` crea este archivo por ti,
# instala las dependencias, prepara la base de datos y la cuenta de prueba.
#
# NO commitees `.env`.


# ─────────────────────────────────────────────────────────────────────
# OBLIGATORIO — es la única variable sin la que la app no arranca
# ─────────────────────────────────────────────────────────────────────

# Base de datos. El valor por defecto usa SQLite y no requiere instalar nada:
# el archivo se crea solo en `instance/sunalyze.db`, siempre en la carpeta del
# proyecto (no depende de desde dónde ejecutes los comandos).
DATABASE_URL=sqlite:///sunalyze.db

# ¿Prefieres MySQL/MariaDB? Cambia la línea de arriba por esta, sustituyendo
# usuario y contraseña por los TUYOS. Ojo: la base y el usuario tienen que
# existir ya — esta línea sólo dice cómo conectarse, no los crea:
#
#   CREATE DATABASE sunalyze;
#   CREATE USER 'sunalyze'@'localhost' IDENTIFIED BY 'tu-password';
#   GRANT ALL PRIVILEGES ON sunalyze.* TO 'sunalyze'@'localhost';
#
# DATABASE_URL=mysql+pymysql://sunalyze:tu-password@127.0.0.1:3306/sunalyze


# ─────────────────────────────────────────────────────────────────────
# TODO LO DEMÁS ES OPCIONAL EN DESARROLLO
# Descomenta sólo lo que necesites. Si no tocas nada, funciona.
# ─────────────────────────────────────────────────────────────────────

# Entorno. `development` (por defecto) relaja los requisitos de secretos.
# En `production` la app EXIGE SECRET_KEY y MFA_ENC_KEY, y aborta si faltan.
# FLASK_ENV=development

# Firma de sesiones. Si la omites en desarrollo se genera una efímera y sólo
# pasa una cosa: al reiniciar el servidor pierdes la sesión y vuelves a entrar.
# Defínela si te molesta ese reinicio. Obligatoria en producción.
#   python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# Cifra el secreto TOTP del MFA en reposo. Sólo hace falta si vas a usar el
# portal de superadmin con MFA. Obligatoria en producción.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MFA_ENC_KEY=

# Portal de superadmin. Sin SERVER_NAME el portal vive en la ruta /superadmin,
# que es lo cómodo en local. Con SERVER_NAME pasa a admin.tudominio.com.
# SERVER_NAME=
# SUPERADMIN_SUBDOMAIN=admin

# Restringe el portal de superadmin por IP (IPs o CIDRs separados por coma).
# Vacía o ausente = sin filtro, que es lo que quieres en local.
# SUPERADMIN_IP_ALLOWLIST=

# Confía en X-Forwarded-For para el filtro de IP. Sólo tras un proxy inverso.
# SUPERADMIN_TRUST_PROXY=

# Email. Por defecto los correos NO se envían: se escriben en el log, que es lo
# correcto en desarrollo. Cambia a `smtp` sólo si necesitas envío real.
# MAIL_BACKEND=smtp
# MAIL_SMTP_HOST=
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USERNAME=
# MAIL_SMTP_PASSWORD=
# MAIL_FROM=

# Reporte de errores a Sentry. Sin DSN el SDK ni siquiera se importa.
# SENTRY_DSN=
