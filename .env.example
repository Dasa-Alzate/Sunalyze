# Sunalyze — variables de entorno
# Copia este archivo a `.env` y rellena los valores. NO commitees `.env`.

# Entorno: "development" (defaults permitidos) o "production" (secretos obligatorios).
FLASK_ENV=development

# Clave de firma de sesiones de Flask. OBLIGATORIA en producción.
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Cadena de conexión a la base de datos. OBLIGATORIA en producción.
# Ejemplo MySQL: mysql+pymysql://usuario:password@host:3306/sunalyze
DATABASE_URL=
