# Sunalyze — variables de entorno
# Copia este archivo a `.env` y rellena los valores. NO commitees `.env`.

# Entorno: "development" o "production".
FLASK_ENV=development

# Clave de firma de sesiones de Flask. Obligatoria en producción; en desarrollo,
# si se omite se genera una efímera (las sesiones se pierden al reiniciar).
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Cadena de conexión a la base de datos. OBLIGATORIA (no hay valor por defecto).
# MySQL/MariaDB:  mysql+pymysql://usuario:password@127.0.0.1:3306/sunalyze
# (esquemas 'mysql://' y 'postgres://' se reescriben automáticamente)
DATABASE_URL=mysql+pymysql://usuario:password@127.0.0.1:3306/sunalyze
