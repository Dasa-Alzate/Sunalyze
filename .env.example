# Sunalyze — variables de entorno
# Copia este archivo a `.env` y rellena los valores. NO commitees `.env`.

# Entorno: "development" o "production".
FLASK_ENV=development

# Clave de firma de sesiones de Flask. Obligatoria en producción; en desarrollo,
# si se omite se genera una efímera (las sesiones se pierden al reiniciar).
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Cadena de conexión a la base de datos. OBLIGATORIA (no hay valor por defecto).
# MySQL/MariaDB:  mysql+pymysql://usuario:password@127.0.0.1:3306/sunalyze
# (esquemas 'mysql://' y 'postgres://' se reescriben automáticamente)
DATABASE_URL=mysql+pymysql://usuario:password@127.0.0.1:3306/sunalyze

# Clave Fernet para cifrar el secreto TOTP (mfa_secret) en reposo. Debe ser una
# clave Fernet válida (base64 urlsafe de 32 bytes). Si se omite, se deriva de
# forma determinista desde SECRET_KEY. Rotar esta clave invalida los secretos ya
# cifrados y obliga a reenrolar el MFA. Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENC_KEY=

# ── Portal de superadmin ───────────────────────────────────────────────
# Subdominio donde se sirve el portal (requiere SERVER_NAME). Si se omite,
# el portal queda bajo la ruta /superadmin (útil en desarrollo local).
SERVER_NAME=
SUPERADMIN_SUBDOMAIN=admin

# Restricción por IP del portal (IPs o CIDRs separados por coma). Si está
# definida se EXIGE; vacía no bloquea (desarrollo). Ej: 203.0.113.4,10.0.0.0/8
SUPERADMIN_IP_ALLOWLIST=

# Si el portal está detrás de un proxy/balanceador, confía en la primera IP
# de X-Forwarded-For para el filtro de IP. Déjalo vacío si no hay proxy.
SUPERADMIN_TRUST_PROXY=
