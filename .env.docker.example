# Variables para el despliegue con Docker Compose.
# Copia a `.env.docker` y rellena. Arranca con:
#   docker compose --env-file .env.docker up -d --build
# NO commitees `.env.docker` (lleva secretos).

# Clave de firma de sesiones de Flask (obligatoria en producción).
# Genera una: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Credenciales de MySQL (el contenedor de DB se inicializa con ellas).
MYSQL_DATABASE=sunalyze
MYSQL_USER=sunalyze
MYSQL_PASSWORD=cambia-esta-password
MYSQL_ROOT_PASSWORD=cambia-esta-root-password

# Puerto público del contenedor web y nº de workers de gunicorn.
WEB_PORT=8000
WEB_CONCURRENCY=3

# Portal de superadmin (rama superadmin-portal). Vacío = sin filtro de IP.
SUPERADMIN_IP_ALLOWLIST=
SUPERADMIN_TRUST_PROXY=1
