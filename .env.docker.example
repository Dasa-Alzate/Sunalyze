# Variables para el despliegue con Docker Compose.
# Copia a `.env.docker` y rellena. Arranca con:
#   docker compose --env-file .env.docker up -d --build
# NO commitees `.env.docker` (lleva secretos).

# Clave de firma de sesiones de Flask (obligatoria en producción).
# Genera una: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Credenciales de MySQL (el contenedor de DB se inicializa con ellas).
MYSQL_DATABASE=sunalyze
MYSQL_USER=sunalyze
MYSQL_PASSWORD=cambia-esta-password
MYSQL_ROOT_PASSWORD=cambia-esta-root-password

# Puerto público del contenedor web y nº de workers de gunicorn.
WEB_PORT=8000
WEB_CONCURRENCY=3

# Portal de superadmin (rama superadmin-portal). Vacío = sin filtro de IP.
SUPERADMIN_IP_ALLOWLIST=
SUPERADMIN_TRUST_PROXY=1

# Observabilidad: DSN de Sentry. Vacío = desactivado (no se importa ni
# inicializa el SDK). Opcionalmente SENTRY_TRACES_SAMPLE_RATE (0.0-1.0).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Correo transaccional. Por defecto MAIL_BACKEND=log: los emails NO se envían,
# solo se registran en el log (comportamiento de desarrollo). Para envío real
# descomenta el bloque y usa MAIL_BACKEND=smtp con cualquier proveedor SMTP
# (SES-SMTP, Brevo, Mailgun, Gmail...); exige MAIL_SMTP_HOST y MAIL_FROM.
# MAIL_BACKEND=smtp
# MAIL_SMTP_HOST=
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USERNAME=
# MAIL_SMTP_PASSWORD=
# MAIL_SMTP_STARTTLS=true
# MAIL_FROM=
# MAIL_TIMEOUT=10
