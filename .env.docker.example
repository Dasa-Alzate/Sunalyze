# Variables para levantar Sunalyze con Docker Compose.
#
# Uso (cualquier sistema operativo):
#   1. Copia este archivo:   cp .env.docker.example .env.docker    (Windows: copy)
#   2. Levanta el stack:     docker compose --env-file .env.docker up -d --build
#   3. Crea la cuenta demo:  docker compose --env-file .env.docker exec web flask seed demo
#
# Los valores de abajo funcionan tal cual para DESARROLLO LOCAL.
# Para un despliegue real: regenera TODOS los secretos y quita ALLOW_SEED_DEMO.
# NO commitees `.env.docker`.

# Clave de firma de sesiones. Regenerar en despliegues reales:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-6f1f7f3f9be14a3a8c1d24bb59c7a1e2c0d9f4b87a6510e3d2c1b0a9f8e7d6c5

# Clave Fernet para cifrar el secreto TOTP (MFA) en reposo. Regenerar en despliegues reales:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENC_KEY=UcJIdsjYboTewTJ2ctEbvtFY2D7DJfm0xfhV3uRoOAA=

# Credenciales del MySQL incluido en el compose (servicio `db`).
MYSQL_DATABASE=sunalyze
MYSQL_USER=sunalyze
MYSQL_PASSWORD=sunalyze-dev-password
MYSQL_ROOT_PASSWORD=sunalyze-dev-root-password

# DB EXTERNA (opcional): si defines DATABASE_URL, la app la usa en lugar del
# MySQL del compose. Ejemplo apuntando a un MySQL/MariaDB de tu máquina:
# DATABASE_URL=mysql+pymysql://usuario:password@host.docker.internal:3306/sunalyze

# Password de Redis (obligatoria). Redis arranca con --requirepass; el puerto
# NO se publica al host.
REDIS_PASSWORD=sunalyze-dev-redis-password

# Permite `flask seed demo` aunque el contenedor corra con FLASK_ENV=production.
# QUITA esta línea en despliegues reales.
ALLOW_SEED_DEMO=1

# Puerto público del contenedor web y nº de workers de gunicorn.
WEB_PORT=8000
WEB_CONCURRENCY=3

# Portal de superadmin. Vacío = sin filtro de IP.
SUPERADMIN_IP_ALLOWLIST=
SUPERADMIN_TRUST_PROXY=1

# Observabilidad: DSN de Sentry. Vacío = desactivado (no se importa ni
# inicializa el SDK). Opcionalmente SENTRY_TRACES_SAMPLE_RATE (0.0-1.0).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Correo transaccional. Por defecto MAIL_BACKEND=log: los emails NO se envían,
# solo se registran en el log (comportamiento de desarrollo). Para envío real
# descomenta el bloque y usa MAIL_BACKEND=smtp con cualquier proveedor SMTP
# (SES-SMTP, Brevo, Mailgun, Gmail...); exige MAIL_SMTP_HOST y MAIL_FROM.
# MAIL_BACKEND=smtp
# MAIL_SMTP_HOST=
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USERNAME=
# MAIL_SMTP_PASSWORD=
# MAIL_SMTP_STARTTLS=true
# MAIL_FROM=
# MAIL_TIMEOUT=10
